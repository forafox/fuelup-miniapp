# Hosts (used in Traefik labels)
BACKEND_HOST=api.example.com
METRICS_HOST=metrics.example.com
GRAFANA_HOST=grafana.example.com
ACME_EMAIL=your-email@example.com

# Service URLs (inter-service)
BACKEND_URL=http://backend:8080
LOKI_URL=http://loki:3100

# Observability
GRAFANA_PASSWORD=change_me_in_production

# Database
POSTGRES_PASSWORD=change_me_in_production

# Redis
REDIS_PASSWORD=change_me_in_production

# JWT
JWT_SECRET=change_me_must_be_at_least_32_chars_long

# Partner API
PARTNER_API_URL=https://api.partner.example.com
PARTNER_API_KEY=your_partner_api_key

# Internal service communication
INTERNAL_API_KEY=change_me_in_production

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret
TELEGRAM_MINI_APP_URL=https://t.me/your_bot/app

# MAX Bot
MAX_BOT_TOKEN=your_max_bot_token
MAX_BOT_MODE=polling

# Carwashes service
CARWASH_PARTNER_URL=https://api.carwash-partner.example.com
CARWASH_PARTNER_KEY=your_carwash_api_key

# Vite (frontend)
VITE_API_URL=https://api.example.com/api/v1
VITE_YANDEX_MAPS_KEY=your_yandex_maps_api_key
